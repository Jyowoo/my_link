// Firebase 콘솔의 Firestore Database → 규칙에 파일 전체를 붙여넣고 게시하세요.
// 콘솔의 기존 내용을 전체 교체하세요. 만료일이 있는 전체 공개 테스트 규칙은 남기지 마세요.
// 여러 규칙이 일치하면 하나만 허용해도 접근이 가능하므로, 전체 공개 규칙은 아래 제한을 무력화합니다.
// 규칙에 명시적으로 허용하지 않은 경로·작업은 기본적으로 거절됩니다.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 로그인 여부와 URL 경로의 소유자 UID를 확인합니다. 표시 이름·username과는 다릅니다.
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    // 이름/주소 예약 문서에는 공개 필드만 허용합니다. 이메일은 포함할 수 없습니다.
    // 공개 정보가 같은 트랜잭션의 사용자 문서와 일치해야 합니다.
    function publicMatches(data, user, uid) {
      return data.keys().hasOnly(['uid', 'displayName', 'username', 'bio', 'photoURL'])
        && data.uid == uid && data.displayName == user.displayName
        && data.username == user.username && data.bio == user.bio && data.photoURL == user.photoURL;
    }
    // users/{uid}에 저장할 프로필을 검사합니다.
    // request.resource.data: 저장 후 데이터, resource.data: 기존 데이터입니다.
    function validProfile(uid) {
      // 표시 이름: 2~30자, 한글·영문·숫자·._+- 허용. 중복 키는 소문자로 통일합니다.
      let data = request.resource.data;
      return data.displayName is string
        && data.displayName.matches('[a-zA-Z0-9가-힣._+-]{2,30}')
        && data.displayNameKey == data.displayName.lower()
        && !(data.displayNameKey in ['links', 'preview', 'settings', 'api', '_next', 'favicon.ico', 'robots.txt', 'sitemap.xml', '.', '..'])
        // 주소 아이디: 소문자 영문·숫자로 시작하는 3~30자. 서비스 예약 주소는 금지합니다.
        && data.username is string && data.username.matches('[a-z0-9][a-z0-9_-]{2,29}')
        && !(data.username in ['links', 'preview', 'settings', 'api', '_next'])
        // 소개는 최대 200자. 사진은 비어 있거나 HTTPS 주소여야 합니다.
        && data.bio is string && data.bio.size() <= 200 && data.email is string
        && data.photoURL is string && data.photoURL.size() <= 2048
        && (data.photoURL == '' || data.photoURL.matches('https://.+'))
        // getAfter는 트랜잭션/배치가 모두 반영된 최종 상태를 검사합니다.
        // 이름 예약·주소 예약·사용자 정보가 함께 일치해야 저장할 수 있습니다.
        && publicMatches(getAfter(/databases/$(database)/documents/displayNames/$(data.displayNameKey)).data, data, uid)
        && publicMatches(getAfter(/databases/$(database)/documents/usernames/$(data.username)).data, data, uid);
    }
    // 표시 이름을 바꿨다면 이전 이름 예약도 같은 트랜잭션에서 삭제해야 합니다.
    // 이름이 그대로이거나 이전 키가 없는 기존 계정이면 해제 검사를 생략합니다.
    function releasesPreviousName() {
      return !('displayNameKey' in resource.data)
        || resource.data.displayNameKey == request.resource.data.displayNameKey
        || !existsAfter(/databases/$(database)/documents/displayNames/$(resource.data.displayNameKey));
    }
    // 주소를 바꿨다면 이전 주소 예약도 해제합니다. 이름 변경만으로는 주소가 바뀌지 않습니다.
    function releasesPreviousAddress() {
      return !('username' in resource.data)
        || resource.data.username == request.resource.data.username
        || !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.username));
    }
    // 선택적인 공개 프로필 하위 문서의 허용 필드·필수 필드와 원본 일치를 검사합니다.
    // 임의 필드·이메일 저장을 막고 updatedAt이 있으면 timestamp 타입만 허용합니다.
    function validPublicProfileDocument(uid) {
      let data = request.resource.data;
      let user = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      return data.keys().hasOnly(['displayName', 'username', 'bio', 'photoURL', 'updatedAt'])
        && data.keys().hasAll(['displayName', 'username', 'bio', 'photoURL'])
        && data.displayName == user.displayName && data.username == user.username
        && data.bio == user.bio && data.photoURL == user.photoURL
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }
    // 현재 앱의 프로필 원본: 이메일이 포함되므로 읽기도 본인만 허용합니다.
    // 프로필 편집은 아래 소유자 검사와 이름·주소 예약 검사를 모두 통과해야 합니다.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validProfile(uid);
      allow update: if isOwner(uid) && validProfile(uid) && releasesPreviousName() && releasesPreviousAddress();
      // 사용자 문서를 삭제하려면 이름·주소 예약도 같은 작업에서 정리해야 합니다.
      allow delete: if isOwner(uid)
        && (!('displayNameKey' in resource.data) || !existsAfter(/databases/$(database)/documents/displayNames/$(resource.data.displayNameKey)))
        && (!('username' in resource.data) || !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.username)));
      // 현재 앱은 users/{uid}를 편집합니다. 아래 하위 문서는 자동으로 생성되지 않습니다.
      // 공개 프로필 경로 예: users/사용자UID/profile/main
      // 누구나 읽고 본인만 변경합니다. 생성·수정은 원본과 동일한 공개 필드만 허용합니다.
      match /profile/{profileId} {
        allow read: if true;
        allow create, update: if isOwner(uid) && validPublicProfileDocument(uid);
        allow delete: if isOwner(uid);
      }
      // 링크 경로 예: users/사용자UID/links/링크ID
      // 모든 방문자가 읽을 수 있지만 생성·수정·삭제는 경로의 UID 본인만 가능합니다.
      match /links/{linkId} {
        allow read: if true;
        allow create, delete: if isOwner(uid);
        // 소유자는 링크 내용을 수정할 수 있지만 클릭 수는 바꿀 수 없습니다.
        // 비로그인 또는 다른 계정 방문자는 다른 필드를 바꾸지 않고 클릭 수만 1 증가시킬 수 있습니다.
        allow update: if (isOwner(uid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['clickCount'])) || (
          !isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount'])
          && request.resource.data.clickCount is int
          && request.resource.data.clickCount == resource.data.get('clickCount', 0) + 1
        );
      }
    }
    // 표시 이름 중복 방지용 예약 문서입니다. 이름 하나는 한 사용자만 소유합니다.
    // 단건 중복 확인은 로그인한 사용자에게만 허용하고 목록 조회(list)는 허용하지 않습니다.
    match /displayNames/{nameKey} {
      // 예약 문서 ID·소유자·공개 정보가 저장 후 사용자 문서와 일치하는지 검사합니다.
      function validName() {
        let user = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return user.displayNameKey == nameKey && user.displayName.lower() == nameKey
          && publicMatches(request.resource.data, user, request.auth.uid);
      }
      allow get: if request.auth != null;
      // 없는 예약은 생성할 수 있지만, 이미 있는 다른 사용자의 예약은 덮어쓸 수 없습니다.
      allow create: if request.auth != null && validName();
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && validName();
      // 본인이 소유하며 사용자 삭제 또는 이름/주소 변경으로 해제되는 예약만 삭제합니다.
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid
        && (!existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
          || getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayNameKey != nameKey);
    }
    // 공개 주소 조회와 주소 중복 방지를 위한 예약 문서입니다.
    // /username 방문 시 이 문서의 uid로 users/{uid}/links를 조회합니다.
    match /usernames/{username} {
      // 주소 예약도 사용자 문서에 기록된 주소와 일치해야 합니다.
      function validAddress() {
        let user = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return user.username == username && publicMatches(request.resource.data, user, request.auth.uid);
      }
      // 비로그인 방문자도 주소 한 개를 조회할 수 있습니다. 전체 주소 목록 조회는 불가합니다.
      allow get: if true;
      // 없는 예약은 생성할 수 있지만, 이미 있는 다른 사용자의 예약은 덮어쓸 수 없습니다.
      allow create: if request.auth != null && validAddress();
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && validAddress();
      // 본인이 소유하며 사용자 삭제 또는 이름/주소 변경으로 해제되는 예약만 삭제합니다.
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid
        && (!existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
          || getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username != username);
    }
  }
}
